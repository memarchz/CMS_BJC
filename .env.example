# Copy to .env.local and fill in your own key. .env.local is gitignored — never commit a real key.
#
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# This key is read only on the server (app/api/ocr/route.ts). Do NOT rename it to
# NEXT_PUBLIC_* — that would ship the key to every visitor's browser.
GEMINI_API_KEY=

# Optional. Leave empty to use the app default, gemini-3.5-flash-lite.
#
# Pick a model with a usable free-tier quota: gemini-3.8-flash allows only 20
# requests per day, which one demo session exhausts. Flash-Lite read the test
# nameplate just as accurately.
#
# Models:       https://ai.google.dev/gemini-api/docs/models
# Your quotas:  https://aistudio.google.com/rate-limit
GEMINI_MODEL=
